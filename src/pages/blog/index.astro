---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Writing | Chris Green" description="Practical perspectives from Chris Green on cybersecurity, risk, compliance, and leadership.">
  <Header />
  <main>
    <section class="page-hero container">
      <p class="eyebrow">Notes & perspectives</p>
      <h1>Writing</h1>
      <p>Practical perspectives on cybersecurity, risk, compliance, and leadership.</p>
    </section>
    <section class="section container listing-section">
      {posts.length === 0 ? (
        <div class="empty-state">
          <p>The first article is in the works. Check back soon.</p>
          <a class="text-link" href="/talks/">Browse talks & resources <span aria-hidden="true">→</span></a>
        </div>
      ) : <div class="article-grid">
        {posts.map((post) => {
          const slug = post.id.replace(/\.md$/, '');
          return <article class="article-card">
            <time class="article-meta" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            <h2><a href={`/blog/${slug}/`}>{post.data.title}</a></h2>
            <p>{post.data.summary}</p>
            <a class="text-link" href={`/blog/${slug}/`}>Read more <span aria-hidden="true">→</span></a>
          </article>;
        })}
      </div>}
    </section>
  </main>
  <Footer />
</Base>
