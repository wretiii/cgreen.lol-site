---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.md$/, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} | Chris Green`} description={post.data.summary}>
  <Header />
  <main>
    <article class="article-shell container">
      <header class="article-header">
        <a class="back-link" href="/blog/">← Back to writing</a>
        <div class="article-kicker"><span>Perspective</span><time datetime={post.data.date.toISOString()}>{formattedDate}</time></div>
        <h1>{post.data.title}</h1>
        <p class="article-summary">{post.data.summary}</p>
      </header>
      <div class="article-content"><Content /></div>
    </article>
  </main>
  <Footer />
</Base>
