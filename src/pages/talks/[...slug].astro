---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const talks = (await getCollection('talks')).filter((talk) => !talk.data.draft);
  return talks.map((talk) => ({ params: { slug: talk.id.replace(/\.md$/, '') }, props: { talk } }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);
const formattedDate = talk.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={`${talk.data.title} | Chris Green`} description={talk.data.summary}>
  <Header />
  <main>
    <article class="article-shell container">
      <header class="article-header">
        <a class="back-link" href="/talks/">← Back to talks</a>
        <div class="article-kicker">
          <span>{talk.data.event ?? 'Speaking'}</span>
          <time datetime={talk.data.date.toISOString()}>{formattedDate}</time>
        </div>
        <h1>{talk.data.title}</h1>
        <p class="article-summary">{talk.data.summary}</p>
        {talk.data.slides && <a class="button primary" href={talk.data.slides}>Download slides <span aria-hidden="true">↓</span></a>}
      </header>
      <div class="article-content"><Content /></div>
    </article>
  </main>
  <Footer />
</Base>
