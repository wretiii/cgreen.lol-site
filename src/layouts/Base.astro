---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Chris Green — Cybersecurity Leader & Speaker',
  description = 'Cybersecurity leader helping organizations strengthen security programs, navigate compliance, and understand real-world exposure.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ef" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/mu-favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
        } catch {}
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline src="/scripts/site.js"></script>
  </body>
</html>
